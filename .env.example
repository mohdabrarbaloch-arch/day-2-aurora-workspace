# ---------------------------------------------------------------------------
# Aurora - environment variables
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------
# "development" enables /api/docs and relaxed logging. "production" hides docs.
APP_ENV=development
APP_NAME=Aurora
# Public base URL, used in OpenAPI servers and CORS defaults.
APP_BASE_URL=http://localhost:8000

# --- Secrets ------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
# The app refuses to start in production if this is left at the default.
SECRET_KEY=change-me-run-openssl-rand-hex-32
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database -----------------------------------------------------------
# Default is a local SQLite file so the app runs with zero setup.
# For Postgres (docker-compose supplies this automatically):
#   DATABASE_URL=postgresql+psycopg://aurora:aurora@db:5432/aurora
DATABASE_URL=sqlite:///./aurora.db
# Echo SQL to stdout. Keep false outside debugging.
SQL_ECHO=false

# --- Uploads ------------------------------------------------------------
# Absolute or relative directory for stored assets.
STORAGE_DIR=./storage
# Per-file ceiling in megabytes. Enforced while streaming, not from headers.
MAX_UPLOAD_MB=15
# Longest edge in pixels for stored images (re-encoded down to this).
MAX_IMAGE_EDGE=1600

# --- CORS ---------------------------------------------------------------
# Comma-separated allowlist. "*" is rejected in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Rate limiting ------------------------------------------------------
# Requests allowed per window, per client IP.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- AI provider --------------------------------------------------------
# "local"  -> built-in BM25 retrieval engine. No key, no network, always works.
# "gemini" -> Google Gemini. Requires GEMINI_API_KEY below.
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Retrieval tuning ---------------------------------------------------
# Chunks returned to the answer composer.
RETRIEVAL_TOP_K=3
# Minimum BM25 score before an answer is considered grounded. Below this the
# app says "not covered by your files" instead of guessing.
RETRIEVAL_MIN_SCORE=0.35
